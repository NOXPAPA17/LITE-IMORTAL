-- Xeno / low-UNC friendly script loader: fixes non-raw pastebin links, never throws, shows errors on screen
CONFIG.LoadURL = function(url)
	local fixed = (url:gsub("^https://pastebin%.com/(%w+)$", "https://pastebin.com/raw/%1"))
	local ok, src = pcall(function() return game:HttpGet(fixed) end)
	if not ok or type(src) ~= "string" or src == "" then
		ok, src = pcall(function() return game:HttpGet(fixed, true) end)
	end
	if not ok or type(src) ~= "string" or src == "" then
		__llToast("Could not download: " .. url, true)
		return
	end
	local fn, err = loadstring(src)
	if not fn then
		__llToast("Script error: " .. tostring(err), true)
		return
	end
	local ok2, err2 = pcall(fn)
	if not ok2 then __llToast("Script error: " .. tostring(err2), true) end
